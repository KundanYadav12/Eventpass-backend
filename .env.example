# EventGen Backend Environment Template
PORT=5006
NODE_ENV=production

# Domain & CORS Configuration (Multi-domain supported)
# Comma-separated list of allowed web domains (e.g. https://managemyshow.com,https://eventgen.duckdns.org)
FRONTEND_URL=https://managemyshow.com
CORS_ORIGIN=https://managemyshow.com,https://www.managemyshow.com,https://eventgen.duckdns.org

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=eventgen_db

# Redis Configuration (Optional - in-memory fallback is automatic)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (Use strong random strings in production)
JWT_SECRET=your_jwt_access_secret_key_here_32_chars_min
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_32_chars_min
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Cryptographic Pass HMAC Secret (32+ character random string)
HMAC_SECRET=your_hmac_sha256_pass_verification_secret_here

# SMTP / Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM="EventGen Support" <noreply@eventgen.duckdns.org>
